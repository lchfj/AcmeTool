<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <PublishAot>true</PublishAot>
    <Nullable>enable</Nullable>
    <PackAsTool>True</PackAsTool>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Setting\SettingTemplate.json" />
    <None Remove="Setting\SettingTemplateEn.json" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Setting\SettingTemplateEn.json" />
    <EmbeddedResource Include="Setting\SettingTemplate.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MailKitLite" Version="4.17.*" />
    <PackageReference Include="AcmeLib" Version="1.0.*" />
  </ItemGroup>

</Project>
